/* ==========================
   RESET
========================== */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{

    font-family:"Space Grotesk",sans-serif;

    background:#050816;

    color:#fff;

    overflow-x:hidden;

}

/* ==========================
   SCROLLBAR
========================== */

::-webkit-scrollbar{
    width:8px;
}

::-webkit-scrollbar-track{
    background:#050816;
}

::-webkit-scrollbar-thumb{

    background:linear-gradient(
        #00E5FF,
        #7C3AED
    );

    border-radius:20px;

}

/* ==========================
BACKGROUND
========================== */

.gradient{

    position:fixed;

    inset:0;

    background:

    radial-gradient(circle at 20% 20%,#00e5ff22,transparent 35%),

    radial-gradient(circle at 80% 70%,#7c3aed33,transparent 35%),

    radial-gradient(circle at 50% 50%,#2563eb22,transparent 45%);

    z-index:-3;

}

/* ==========================
FLOATING BLOBS
========================== */

.blob{

    position:fixed;

    border-radius:50%;

    filter:blur(80px);

    animation:float 15s ease infinite;

    opacity:.45;

}

.blob1{

    width:320px;
    height:320px;

    background:#00E5FF;

    left:-120px;
    top:50px;

}

.blob2{

    width:350px;
    height:350px;

    background:#8B5CF6;

    right:-120px;
    top:180px;

    animation-delay:4s;

}

.blob3{

    width:280px;
    height:280px;

    background:#2563EB;

    bottom:-120px;
    left:35%;

    animation-delay:8s;

}

@keyframes float{

0%{

transform:
translateY(0)
translateX(0)
scale(1);

}

25%{

transform:
translateY(-40px)
translateX(30px)
scale(1.08);

}

50%{

transform:
translateY(30px)
translateX(-30px)
scale(.95);

}

75%{

transform:
translateY(-20px)
translateX(60px)
scale(1.05);

}

100%{

transform:
translateY(0)
translateX(0)
scale(1);

}

}

/* ==========================
LOADER
========================== */

.loader{

position:fixed;

inset:0;

background:#050816;

display:flex;

justify-content:center;

align-items:center;

flex-direction:column;

z-index:99999;

transition:1s;

}

.spinner{

width:80px;

height:80px;

border-radius:50%;

border:6px solid #222;

border-top:6px solid cyan;

animation:spin .8s linear infinite;

margin-bottom:20px;

}

@keyframes spin{

100%{

transform:rotate(360deg);

}

}

/* ==========================
CURSOR
========================== */

.cursor{

position:fixed;

width:18px;

height:18px;

border-radius:50%;

background:#00E5FF;

pointer-events:none;

transform:translate(-50%,-50%);

z-index:999;

mix-blend-mode:screen;

box-shadow:

0 0 20px cyan,

0 0 60px cyan;

transition:.08s;

}

.cursor2{

position:fixed;

width:45px;

height:45px;

border-radius:50%;

border:2px solid cyan;

pointer-events:none;

transform:translate(-50%,-50%);

transition:.15s;

z-index:998;

}

/* ==========================
HEADER
========================== */

header{

position:fixed;

top:25px;

left:50%;

transform:translateX(-50%);

width:90%;

display:flex;

justify-content:space-between;

align-items:center;

padding:18px 35px;

border-radius:20px;

backdrop-filter:blur(25px);

background:rgba(255,255,255,.05);

border:1px solid rgba(255,255,255,.08);

z-index:100;

}

.logo{

font-size:28px;

font-weight:bold;

background:linear-gradient(
90deg,
cyan,
#8B5CF6);

-webkit-background-clip:text;

-webkit-text-fill-color:transparent;

}

nav{

display:flex;

gap:35px;

}

nav a{

color:white;

text-decoration:none;

font-weight:500;

transition:.3s;

position:relative;

}

nav a::after{

content:"";

position:absolute;

left:0;

bottom:-8px;

width:0;

height:2px;

background:cyan;

transition:.3s;

}

nav a:hover{

color:cyan;

}

nav a:hover::after{

width:100%;

}

/* ==========================
HERO
========================== */

.hero{

min-height:100vh;

display:flex;

justify-content:space-between;

align-items:center;

padding:0 8%;

}

.hero-text{

width:55%;

}

.hero-text p{

font-size:18px;

color:#9CA3AF;

margin-bottom:20px;

}

.hero-text h1{

font-size:75px;

line-height:80px;

margin-bottom:15px;

}

.hero-text h2{

font-size:38px;

color:cyan;

margin-bottom:25px;

min-height:45px;

}

.desc{

line-height:32px;

max-width:600px;

}

.buttons{

display:flex;

gap:20px;

margin-top:40px;

}

/* ==========================
BUTTONS
========================== */
/* ==========================
BUTTON
========================== */

.btn,
button{

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:10px;

    padding:16px 36px;

    border:none;

    border-radius:50px;

    cursor:pointer;

    font-size:16px;

    font-weight:600;

    color:#fff;

    text-decoration:none;

    background:linear-gradient(
        135deg,
        #00E5FF,
        #7C3AED
    );

    transition:all .35s ease;

    box-shadow:
        0 0 20px rgba(0,229,255,.35);

}

.btn:hover,
button:hover{

    transform:translateY(-6px) scale(1.03);

    box-shadow:
        0 0 20px #00E5FF,
        0 0 40px #7C3AED,
        0 0 80px rgba(124,58,237,.5);

}

.btn:active,
button:active{

    transform:scale(.97);

}

.outline{

    background:transparent;

    border:2px solid #00E5FF;

    color:#fff;

}

.outline:hover{

    background:#00E5FF;

    color:#050816;

}
/* ==========================
HERO IMAGE
========================== */

.hero-image{

    width:420px;

    height:420px;

    position:relative;

}

.circle{

    position:absolute;

    inset:0;

    border-radius:50%;

    background:

    linear-gradient(
    135deg,
    cyan,
    #7C3AED
    );

    filter:blur(60px);

    opacity:.6;

    animation:rotate 10s linear infinite;

}

.hero-image img{

    width:100%;

    position:relative;

    z-index:2;

    animation:

    floating 5s ease infinite;

    filter:drop-shadow(
    0 0 40px cyan);

}

@keyframes floating{

0%{

transform:translateY(0);

}

50%{

transform:translateY(-25px);

}

100%{

transform:translateY(0);

}

}

@keyframes rotate{

100%{

transform:rotate(360deg);

}

}

/* ==========================
TITLE
========================== */

.title{

    text-align:center;

    font-size:50px;

    margin-bottom:80px;

    position:relative;

}

.title::after{

    content:"";

    width:120px;

    height:4px;

    border-radius:20px;

    background:cyan;

    position:absolute;

    left:50%;

    bottom:-20px;

    transform:translateX(-50%);

}

/* ==========================
ABOUT
========================== */

section{

    padding:120px 10%;

}

.about{

    display:grid;

    grid-template-columns:

    1.5fr 1fr;

    gap:70px;

}

.about h3{

    font-size:40px;

    margin-bottom:25px;

}

.about p{

    color:#B6BCCB;

    line-height:35px;

}

.stats{

    display:grid;

    grid-template-columns:repeat(3,1fr);

    gap:20px;

}

.stats div{

    background:rgba(255,255,255,.04);

    border:1px solid rgba(255,255,255,.08);

    backdrop-filter:blur(20px);

    padding:35px;

    border-radius:20px;

    text-align:center;

    transition:.4s;

}

.stats div:hover{

    transform:translateY(-12px);

    box-shadow:0 0 30px #00E5FF33;

}

.stats h1{

    font-size:45px;

    color:cyan;

}

.stats p{

    margin-top:10px;

}

/* ==========================
SKILLS
========================== */

.skill{

    margin:35px auto;

    max-width:900px;

}

.skill span{

    display:block;

    margin-bottom:10px;

    font-size:18px;

}

.bar{

    height:14px;

    background:#1E293B;

    border-radius:30px;

    overflow:hidden;

}

.bar div{

    height:100%;

    border-radius:30px;

    background:

    linear-gradient(
    90deg,
    cyan,
    #7C3AED);

    width:0;

    transition:2s;

    box-shadow:

    0 0 20px cyan;

}

/* ==========================
PROJECT
========================== */

.cards{

    display:grid;

    grid-template-columns:

    repeat(auto-fit,minmax(340px,1fr));

    gap:40px;

}

.card{

    position:relative;

    overflow:hidden;

    border-radius:25px;

    background:#111827;

    transition:.5s;

    transform-style:preserve-3d;

    cursor:pointer;

}

.card:hover{

    transform:

    rotateX(8deg)

    rotateY(-8deg)

    translateY(-15px);

}

.card img{

    width:100%;

    height:260px;

    object-fit:cover;

}

.card::before{

    content:"";

    position:absolute;

    inset:0;

    background:

    linear-gradient(

    transparent,

    rgba(0,0,0,.75)

    );

}

.content{

    position:absolute;

    bottom:30px;

    left:30px;

    z-index:3;

}

.content h3{

    font-size:28px;

    margin-bottom:8px;

}

.content p{

    color:#ddd;

}

/* Glow */

.card::after{

    content:"";

    position:absolute;

    width:250px;

    height:250px;

    background:cyan;

    border-radius:50%;

    filter:blur(120px);

    opacity:0;

    transition:.6s;

    top:-100px;

    right:-100px;

}

.card:hover::after{

    opacity:.3;

}

/* ==========================
CONTACT
========================== */

form{

    max-width:750px;

    margin:auto;

    display:flex;

    flex-direction:column;

    gap:25px;

}

input,

textarea{

    background:rgba(255,255,255,.05);

    border:1px solid rgba(255,255,255,.1);

    padding:20px;

    color:white;

    border-radius:18px;

    outline:none;

    backdrop-filter:blur(15px);

    transition:.3s;

}

input:focus,

textarea:focus{

    border-color:cyan;

    box-shadow:

    0 0 20px #00E5FF55;

}

textarea{

    resize:none;

    height:180px;

}

/* ==========================
FOOTER
========================== */

footer{

    padding:40px;

    text-align:center;

    color:#8A93A5;

    border-top:

    1px solid rgba(255,255,255,.05);

}

/* ==========================
RESPONSIVE
========================== */

@media(max-width:1000px){

.hero{

flex-direction:column-reverse;

text-align:center;

padding-top:160px;

}

.hero-text{

width:100%;

}

.hero-image{

margin-bottom:70px;

width:320px;

height:320px;

}

.about{

grid-template-columns:1fr;

}

.stats{

grid-template-columns:1fr;

}

nav{

display:none;

}

.hero-text h1{

font-size:55px;

line-height:60px;

}

.title{

font-size:38px;

}

}